# One server block per subdomain (CLAUDE.md §3). ${BASE_DOMAIN} and ${URL_SCHEME} are filled
# from the environment by the nginx image; nginx's own $variables are left untouched.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Keep a non-standard port (local development) when redirecting between subdomains.
map $http_host $port_suffix {
    "~^[^:]+(?<port>:\d+)$" $port;
    default                 "";
}

# Re-resolve container names through Docker DNS, so recreated containers (new IPs after a
# deploy) are picked up without restarting nginx. Needs nginx >= 1.27.3.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream backend { zone backend 64k; server backend:8000 resolve; }
upstream mobile  { zone mobile 64k;  server mobile:3000 resolve; }
upstream admin   { zone admin 64k;   server admin:3001 resolve; }

server_tokens off;
client_max_body_size 2m;

# Unknown hosts get nothing.
server {
    listen 80 default_server;
    return 444;
}

# m. — mobile surface and PWA (serves every device in Phase 1).
server {
    listen 80;
    server_name m.${BASE_DOMAIN};
    include /etc/nginx/snippets/security.conf;

    location /api/ { include /etc/nginx/snippets/proxy.conf; proxy_pass http://backend; }
    location /ws   { include /etc/nginx/snippets/websocket.conf; proxy_pass http://backend; }
    location /     { include /etc/nginx/snippets/proxy.conf; proxy_pass http://mobile; }
}

# admin. — admin panel, separate host-only cookies (CLAUDE.md §12.1).
server {
    listen 80;
    server_name admin.${BASE_DOMAIN};
    include /etc/nginx/snippets/security.conf;

    location /api/ { include /etc/nginx/snippets/proxy.conf; proxy_pass http://backend; }
    location /     { include /etc/nginx/snippets/proxy.conf; proxy_pass http://admin; }
}

# app. and root — Phase 1 (DESKTOP_ENABLED=false): redirect every page to the same path and
# query on m. (CLAUDE.md §11.0). API and WebSocket are never redirected. Phase 2 replaces the
# redirect with the desktop app, whose middleware applies device routing.
server {
    listen 80;
    server_name app.${BASE_DOMAIN} ${BASE_DOMAIN} www.${BASE_DOMAIN};
    include /etc/nginx/snippets/security.conf;

    location /api/ { include /etc/nginx/snippets/proxy.conf; proxy_pass http://backend; }
    location /ws   { include /etc/nginx/snippets/websocket.conf; proxy_pass http://backend; }
    location /     { return 302 ${URL_SCHEME}://m.${BASE_DOMAIN}$port_suffix$request_uri; }
}
