# Copy to .env and fill in. Never commit .env (CLAUDE.md §22.1).

# Domain and surfaces (CLAUDE.md §1, §11.0)
BASE_DOMAIN=localhost
URL_SCHEME=http
HTTP_PORT=80
APP_NAME=Takhte Nard
DESKTOP_ENABLED=false

# PostgreSQL
POSTGRES_DB=backgammon
POSTGRES_USER=backgammon
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Fernet key for encrypting match seeds at rest (CLAUDE.md §6). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEED_ENCRYPTION_KEY=

# Providers (CLAUDE.md §18)
SMS_PROVIDER=console
PAYMENT_GATEWAY=sandbox
