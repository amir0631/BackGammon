# Copy to .env and fill in. Never commit .env (CLAUDE.md §22.1).

# Domain and surfaces (CLAUDE.md §1, §11.0)
BASE_DOMAIN=localhost
URL_SCHEME=http
HTTP_PORT=80
APP_NAME=Takhte Nard
# Web Push (§11.5): generate with `python manage.py vapid_keys`; empty disables push.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
DESKTOP_ENABLED=false
# development | staging | production. Shown in the admin header; production refuses seed_testers.
APP_ENV=development

# PostgreSQL
POSTGRES_DB=backgammon
POSTGRES_USER=backgammon
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Fernet key for encrypting match seeds at rest (CLAUDE.md §6). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEED_ENCRYPTION_KEY=

# Providers (CLAUDE.md §18). SMS details: sms.md
SMS_PROVIDER=console
PAYMENT_GATEWAY=sandbox

# IPPanel Edge (used when SMS_PROVIDER=ippanel). Never commit the key.
# Sender line and pattern codes are admin-panel settings (sms.*), see sms.md.
IPPANEL_BASE_URL=https://edge.ippanel.com/v1
IPPANEL_API_KEY=

# Admin panel (CLAUDE.md §12.1). Comma-separated CIDRs; empty allows any IP.
ADMIN_IP_ALLOWLIST=
